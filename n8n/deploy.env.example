# Copy to n8n/deploy.env (git-ignored). Used by: python3 n8n/deploy.py
# SSH target for the tunnel to the VPS (n8n listens on 127.0.0.1:5678 there, never publicly).
N8N_SSH=john@76.13.110.193
# n8n -> Settings -> n8n API -> Create an API key
N8N_API_KEY=
# The website the collectors feed
SITE_BASE_URL=https://buy-zone.johnvgodwin.cloud
# api_token from public/config.local.php on the site. If set, the script creates the
# "BuyZone — Ingest Token" credential and binds it; if empty you bind a credential by hand.
SITE_API_TOKEN=
# Optional. Twelve Data key (stocks/commodities). Empty = credential created with a placeholder.
TWELVEDATA_API_KEY=
# Optional. ntfy topic URL; empty = copied from the existing "BTC Buy-Zone Alerts" workflow.
NTFY_URL=
# Optional. Only if the ntfy topic requires a token (Authorization: Bearer tk_...).
NTFY_TOKEN=
# Optional. https://api.binance.us if binance.com is geo-blocked from the VPS.
BINANCE_BASE=https://api.binance.com
